# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=sih
POSTGRES_PASSWORD=sihpass
POSTGRES_DB=sih
DATABASE_URL=postgresql+psycopg://sih:sihpass@db:5432/sih

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# CHANGE this to a long random string in production: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
STORAGE_DIR=/data/uploads
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80
DEMO_CLOCK_OFFSET_DAYS=0

# ── AI / ML ───────────────────────────────────────────────────────────────────
# Overlap threshold: complaints with score >= this are flagged (0.40 recommended by evaluation)
OVERLAP_THRESHOLD=0.40

# Similarity mode for complaint text comparison:
#   tfidf     (default) – TF-IDF only, no extra deps
#   hybrid    – max(TF-IDF, semantic embedding); best accuracy but needs sentence-transformers
#   embedding – semantic embeddings only
SIMILARITY_MODE=tfidf

# Sentence-transformers model (used when SIMILARITY_MODE=hybrid or embedding)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For Hindi/regional text:
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Cosine floor for embedding rescaling (default 0.30)
# EMBEDDING_FLOOR=0.30

# LLM-based overlap explanations (optional; never hard-code or commit the key!)
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
# LLM_MAX_TOKENS=400

# Data/docs directory overrides (default: auto-detected from paths.py)
# AI_DATA_DIR=/app/data
# AI_DOCS_DIR=/app/docs
