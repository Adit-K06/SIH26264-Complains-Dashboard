# Copy to .env (never commit .env)
# Required in production: generate a real 32-char random SECRET_KEY

SECRET_KEY=dev-secret-change-in-production-32char
APP_ENV=development
LOG_LEVEL=INFO

# Database (default matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg2://aicte:aicte@db:5432/aicte

# Optional AI features (set to true and provide key to enable)
LLM_ENABLED=false
OPENAI_API_KEY=
